# Hirely Environment Variables
# Copy this file to .env and fill in the values

# Clerk Authentication (required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_server_key_here
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# SerpApi for Job Search (required)
SERPAPI_KEY=your_serpapi_key_here

# Google Gemini AI (required for chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (required for persistence)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_service_role_key_here
# Never expose this key with a VITE_ prefix or send it to browser code.

# Server-only API bridge configuration; do not use VITE_ prefixes.
# Add the exact newly deployed Vercel origin before production deployment.
PIPELINE_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com
PIPELINE_ASSERTION_SECRET=generate-a-random-secret-of-at-least-32-characters

# Existing Vercel-side Gemini features use this key. Pipeline Lambda functions
# receive a separate server-side copy through the SAM GeminiApiKey parameter.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
MATCH_THRESHOLD=70
